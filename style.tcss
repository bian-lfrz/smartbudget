/* =====================================================================
   1. DASAR LAYAR, HEADER, FOOTER & SCROLLBAR
   ===================================================================== */
Screen {
    background: #09090b;
    color: #e4e4e7;
    scrollbar-background: #09090b;
    scrollbar-color: #27272a;
    scrollbar-color-hover: #3f3f46;
    scrollbar-color-active: #38bdf8;
}

Header {
    background: #121215;
    color: #f4f4f5;
    border-bottom: solid #27272a;
}

Footer {
    background: #121215;
    color: #a1a1aa;
    border-top: solid #27272a;
}

FooterKey {
    background: #18181c;
    color: #e4e4e7;
}

FooterKey > .footer-key--key {
    background: #27272a;
    color: #38bdf8;
    text-style: bold;
}

/* =====================================================================
   2. HALAMAN LOGIN & REGISTRASI
   ===================================================================== */
LoginScreen, RegisterScreen {
    align: center middle;
    background: #09090b;
}

.box {
    width: 60;
    height: auto;
    border: round #2e2e34;
    padding: 1 3;
    background: #121215;
}

.judul {
    text-align: center;
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
}

.row-btn {
    height: auto;
    align: center middle;
    margin-top: 1;
}

.row-btn Button {
    margin: 0 1;
}

/* =====================================================================
   3. DASHBOARD HEADER & KARTU RINGKASAN (KPI)
   ===================================================================== */
MahasiswaScreen, OrangTuaScreen {
    background: #09090b;
    overflow: hidden hidden;
}

#top-bar, #top-bar-ortu {
    height: auto;
    padding: 0 2;
    background: #121215;
    border-bottom: solid #27272a;
    align: left middle;
}

#lbl-user, #lbl-info-ortu {
    width: 1fr;
    text-style: bold;
    color: #f4f4f5;
}

#kpi-grid, #kpi-grid-ortu {
    height: 5;
    padding: 0 1;
    margin-top: 1;
}

.kpi-card {
    width: 1fr;
    height: 5;
    margin: 0 1;
    padding: 0 2;
    background: #121215;
    border: round #27272a;
    content-align: left middle;
}

.kpi-title {
    color: #71717a;
    text-style: bold;
}

#val-masuk, #val-ortu-masuk { color: #10b981; text-style: bold; }
#val-keluar, #val-ortu-keluar { color: #f43f5e; text-style: bold; }
#val-saldo, #val-ortu-saldo { color: #38bdf8; text-style: bold; }
#val-batas, #val-ortu-batas { color: #c084fc; text-style: bold; }

/* =====================================================================
   4. NAVIGASI TAB & AREA SCROLL
   ===================================================================== */
TabbedContent, TabbedContent > ContentSwitcher, .scroll-area {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

Tabs {
    background: #09090b;
    border-bottom: solid #27272a;
    padding: 0 1;
}

Tab {
    color: #71717a;
    padding: 0 2;
}

Tab:hover {
    color: #e4e4e7;
    background: #18181c;
}

Tab.-active {
    color: #38bdf8;
    text-style: bold;
    background: #121215;
}

Underline > .underline--bar {
    color: #38bdf8;
    background: #27272a;
}

/* Aksen Warna Khusus Dashboard Orang Tua */
OrangTuaScreen Tab.-active {
    color: #c084fc;
}

OrangTuaScreen Underline > .underline--bar {
    color: #c084fc;
}

OrangTuaScreen .sub-judul,
OrangTuaScreen .card-title {
    color: #c084fc;
}

OrangTuaScreen Input:focus,
OrangTuaScreen Select:focus {
    border: tall #c084fc;
}

/* =====================================================================
   5. FILTER BAR, BARIS AKSI & KOMENTAR
   ===================================================================== */
.filter-bar {
    padding: 1 2 0 2;
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.filter-bar Input {
    width: 38;
    margin-right: 1;
    margin-bottom: 0;
}

.filter-bar Button {
    margin-right: 1;
}

.komen-bar {
    margin-top: 1;
    height: auto;
    align: left middle;
}

#komen-id {
    width: 24;
    margin-right: 1;
    margin-bottom: 0;
}

#komen-teks {
    width: 1fr;
    margin-right: 1;
    margin-bottom: 0;
}

/* =====================================================================
   6. KARTU LAPORAN, GRAFIK ANALITIK & FORM INPUT
   ===================================================================== */
.split-grid {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.report-card {
    width: 1fr;
    height: auto;
    background: #121215;
    border: round #27272a;
    padding: 1 2;
    margin: 0 1;
}

.report-card-full {
    height: auto;
    background: #121215;
    border: round #27272a;
    padding: 1 2;
    margin: 0 2 1 2;
}

.card-header-row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: solid #27272a;
}

.sub-judul {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
    border-bottom: solid #27272a;
    padding-bottom: 1;
}

.sub-judul-inline {
    width: 1fr;
    text-style: bold;
    color: #f4f4f5;
}

.input-id-mini {
    width: 24;
    margin-right: 1;
    margin-bottom: 0;
}

.visual-body {
    height: auto;
    color: #d4d4d8;
}

.card-form {
    width: 72;
    max-width: 92%;
    height: auto;
    background: #121215;
    border: round #2e2e34;
    padding: 1 3;
    margin: 1 0;
}

.card-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
    border-bottom: solid #27272a;
    padding-bottom: 1;
}

.field-label {
    color: #a1a1aa;
    text-style: bold;
    margin-bottom: 0;
}

#info-ortu {
    background: #18181c;
    padding: 1 2;
    border: round #2e2e34;
    margin-bottom: 1;
    color: #e4e4e7;
}

/* =====================================================================
   7. INPUT, SELECT, BUTTON & DATATABLE
   ===================================================================== */
Input, Select {
    margin-bottom: 1;
    background: #18181c;
    border: tall #2e2e34;
    color: #f4f4f5;
}

Input:focus, Select:focus {
    border: tall #38bdf8;
    background: #1c1c22;
}

Input > .input--placeholder {
    color: #52525b;
}

SelectCurrent {
    background: #18181c;
    color: #f4f4f5;
}

SelectOverlay {
    background: #18181c;
    border: round #38bdf8;
}

OptionList > .option-list--option-highlighted {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
}

Button {
    height: 3;
    min-width: 12;
    text-style: bold;
}

.btn-full {
    width: 100%;
    margin-top: 1;
}

DataTable {
    height: 8;
    background: #0e0e11;
    color: #e4e4e7;
}

DataTable > .datatable--header {
    background: #18181c;
    color: #a1a1aa;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: #111115;
}

DataTable > .datatable--even-row {
    background: #0d0d10;
}

DataTable > .datatable--cursor {
    background: #1e293b;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #181820;
}